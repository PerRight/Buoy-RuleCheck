# ── 빌드·캐시 ──
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
autocad/**/bin/
autocad/**/obj/
.vs/
*.user
.venv/
venv/
*.egg-info/

# ── AutoCAD 임시·잠금 파일 ──
*.bak
*.dwl
*.dwl2
*.sv$
*.ac$
plot.log

# ── 도면: 실제 조선소 도면은 보안 자료일 수 있으므로 저장소에 올리지 않는다 ──
# 샘플은 합성 도면(samples/S140_*.dxf)만 허용. 실도면 DWG·DXF는 저장소 밖 폴더에서 연다.
# (확장자는 대소문자 무관. 차단 줄은 예외 줄보다 앞에 둔다 — 뒤에 두면 예외가 다시 막힌다)
*.[Dd][Ww][Gg]
*.[Dd][Ww][Tt]
*.[Dd][Ww][Ff]
*.[Dd][Ww][Ff][Xx]
*.[Dd][Xx][Ff]
!samples/S140_*.dxf

# 검토 리포트(도면 내용 포함): 플러그인이 도면 옆에 저장하는 것, CLI(python -m brc report -o 아무이름.html)가 만드는 것.
# 이름으로는 다 못 막으므로 HTML은 전부 막고 예시 하나만 허용한다. 새 HTML이 필요하면 예외 줄을 PR로 추가.
*.[Hh][Tt][Mm][Ll]
*.[Hh][Tt][Mm]
!samples/S140_report_example.html

# 플러그인 버전 기록(도면 옆 <도면이름>.brc/, 옛 이름 .garc/ — GA_ 레이어 스냅샷이라 도면 내용 포함). 데모 샘플만 허용.
*.brc/
*.garc/
!samples/S140_*.brc/

# 규정집 PDF(선급·협약 원문 — 저작권 자료일 수 있음)는 공개 저장소에 올리지 않는다
규정/

# Claude Code 개인 설정
.claude/settings.local.json
.claude/*.lock

# ── OS·편집기·비밀값 ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.env
.env.*
