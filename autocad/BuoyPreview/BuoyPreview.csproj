<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Buoy-RuleCheck 단독 미리보기(AutoCAD 없이 실행): 오브·떠 있는 로고·도면 위 부표 상태 흐름·크기별 점 수·동작 줄이기·부표 카드·팔레트.
    팔레트 샘플(samples.json)은 make_samples.py가 합성 샘플 S140에서 만든다.
    실행(Windows):  cd autocad\BuoyPreview  →  dotnet run
    플러그인과 같은 소스 파일(Theme·OrbModel·OrbRenderer·BuoyAnim·BuoyCard·ResultPanel·RuleCard…)을 링크해서 그리므로, 여기서 보이는 모습이 플러그인 모습이다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BuoyRuleCheck</RootNamespace>
    <AssemblyName>BuoyPreview</AssemblyName>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BuoyRuleCheck\Theme.cs" Link="Shared\Theme.cs" />
    <Compile Include="..\BuoyRuleCheck\OrbModel.cs" Link="Shared\OrbModel.cs" />
    <Compile Include="..\BuoyRuleCheck\OrbRenderer.cs" Link="Shared\OrbRenderer.cs" />
    <Compile Include="..\BuoyRuleCheck\BuoyAnim.cs" Link="Shared\BuoyAnim.cs" />
    <Compile Include="..\BuoyRuleCheck\UiState.cs" Link="Shared\UiState.cs" />
    <Compile Include="..\BuoyRuleCheck\Dto.cs" Link="Shared\Dto.cs" />
    <Compile Include="..\BuoyRuleCheck\UiText.cs" Link="Shared\UiText.cs" />
    <Compile Include="..\BuoyRuleCheck\BuoyCard.cs" Link="Shared\BuoyCard.cs" />
    <Compile Include="..\BuoyRuleCheck\PaletteParts.cs" Link="Shared\PaletteParts.cs" />
    <Compile Include="..\BuoyRuleCheck\RuleCard.cs" Link="Shared\RuleCard.cs" />
    <Compile Include="..\BuoyRuleCheck\ResultPanel.cs" Link="Shared\ResultPanel.cs" />
    <Compile Include="..\BuoyRuleCheck\ShipInfoView.cs" Link="Shared\ShipInfoView.cs" />
    <Compile Include="..\BuoyRuleCheck\DrawingPropsText.cs" Link="Shared\DrawingPropsText.cs" />
    <Compile Include="..\BuoyRuleCheck\FloatingParts.cs" Link="Shared\FloatingParts.cs" />
    <Compile Include="..\BuoyRuleCheck\ParticularsDialog.cs" Link="Shared\ParticularsDialog.cs" />
    <Compile Include="..\BuoyRuleCheck\LinkProgress.cs" Link="Shared\LinkProgress.cs" />
    <Compile Include="..\BuoyRuleCheck\CompareForm.cs" Link="Shared\CompareForm.cs" />
    <Compile Include="..\BuoyRuleCheck\CompareParts.cs" Link="Shared\CompareParts.cs" />
    <Compile Include="..\BuoyRuleCheck\CompareCanvas.cs" Link="Shared\CompareCanvas.cs" />
    <Compile Include="..\BuoyRuleCheck\ExportSheet.cs" Link="Shared\ExportSheet.cs" />
    <Compile Include="..\BuoyRuleCheck\RasterPdf.cs" Link="Shared\RasterPdf.cs" />
    <Compile Include="..\BuoyRuleCheck\VersionStore.cs" Link="Shared\VersionStore.cs" />
    <Compile Include="..\BuoyRuleCheck\EngineClient.cs" Link="Shared\EngineClient.cs" />
    <Compile Include="..\BuoyRuleCheck\HitIndex.cs" Link="Shared\HitIndex.cs" />
    <EmbeddedResource Include="samples.json" LogicalName="BuoyPreview.samples.json" />
    <EmbeddedResource Include="samples_compare.json" LogicalName="BuoyPreview.samples_compare.json" />
  </ItemGroup>
</Project>
