# 줄바꿈: 저장소 안은 LF로 통일, 체크아웃 시 각 OS 설정을 따른다
* text=auto

# PowerShell 스크립트는 Windows 줄바꿈 유지 (UTF-8 BOM은 git이 그대로 보존)
*.ps1 text eol=crlf

# DXF 샘플은 바이트 그대로 (줄바꿈 변환 금지 — 체크아웃한 OS와 관계없이 같은 파일)
*.dxf -text

# 바이너리
*.dwg binary
*.dll binary
*.pdb binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# 설치 패키지의 .cmd: 한국어 Windows 콘솔 코드 페이지(cp949) + CRLF 바이트 그대로(UTF-8로 바꾸면 echo 한글이 깨진다)
tools/package/payload/*.cmd -text
# 패키지 안내문: UTF-8 BOM + CRLF 그대로(메모장에서 바로 읽히게)
tools/package/payload/README.txt -text
